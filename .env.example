# API / server
APP_NAME=RAG2 Modular Monolith
APP_DESCRIPTION=Modular monolith event-driven scaffold
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_ADMIN_LOCAL_ONLY=true
APP_ADMIN_REMOTE_ALLOW_PATHS=/admin/models,/admin/engrams,/admin/context-graph,/admin/sagas
APP_RATE_LIMIT_WINDOW_SECONDS=60
APP_RATE_LIMIT_MAX_REQUESTS=120
APP_BAN_LIST=

# Conversation governance for the chat API
APP_CONVERSATION_GUARD_ENABLED=true
APP_CONVERSATION_SANITIZE_ENABLED=true
APP_CONVERSATION_TIMEOUT_ENABLED=true
APP_CONVERSATION_TELEMETRY_ENABLED=true
APP_CONVERSATION_DEBUG_TRACE_ENABLED=false
APP_CONVERSATION_DEADLINE_SCALE_PERCENT=100
APP_CONVERSATION_INTENT_BUNDLE_ID=
APP_CONVERSATION_INTENT_MAX_TOKENS=8
APP_CONVERSATION_IMMERSIVE_MODE_ENABLED=false
APP_CONVERSATION_IMMERSIVE_RETRY_MAX=1
APP_CONVERSATION_IMMERSIVE_THRESHOLD_PERCENT=65
APP_CONVERSATION_IMMERSIVE_STRICT_ENGRAM=true
APP_CHAT_TRASH_RETENTION_HOURS=24

# Model storage / discovery
# AI_MODELS_DIR is preferred; AI_MODEL_DIR is still accepted as a legacy alias.
AI_MODELS_DIR=./ai_models
AI_MODEL_DIR=./ai_models
VAULT_DIR=./.vault

# Text inference runtime
LLM_PROVIDER=local
LLM_MODEL_PATH=
LLAMA_CPP_N_CTX=32768
LMSTUDIO_BASE_URL=http://localhost:8000
LMSTUDIO_MODEL=
LMSTUDIO_N_CTX=32768

# Vision inference runtime
VISION_PROVIDER=local
VISION_MODEL_PATH=
VISION_MM_PROJECTOR_PATH=
VISION_OLLAMA_BASE_URL=http://localhost:11434
VISION_OLLAMA_MODEL=llava
# Shared LM Studio endpoint unless vision needs an override.
VISION_LMSTUDIO_BASE_URL=
VISION_LMSTUDIO_MODEL=

# Optional llama.cpp text generation tuning (model-runtime-config.json overrides these values)
TEXT_GENERATION_MIN_P=0.03
TEXT_GENERATION_REPEAT_PENALTY=1.08
TEXT_GENERATION_PRESENCE_PENALTY=0.0
TEXT_GENERATION_FREQUENCY_PENALTY=0.0
TEXT_GENERATION_SEED=-1

# Database / persistence
DATABASE_URL=
DATABASE_ECHO=false
DATABASE_CREATE_SCHEMA_ON_START=true
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30